{
  "lines": [
    { "id": "l1", "text": "For 156 years, Hong Kong was a British colony.", "caps": "For *156* years,|Hong Kong was a|British *colony*." },
    { "id": "l2", "text": "It began in 1842, after China lost the Opium War." },
    { "id": "l3", "text": "In 1898, Britain leased the New Territories for 99 years." },
    { "id": "l4", "text": "In 1984, they agreed Hong Kong would return to China." },
    { "id": "l5", "text": "The promise: one country, two systems." },
    { "id": "l6", "text": "At midnight on July 1st, 1997, the flag changed.", "caps": "At midnight|on July 1st, 1997,|the *flag* changed." },
    { "id": "l7", "text": "6.5 million people woke up under new rule." },
    { "id": "l8", "text": "Their way of life was guaranteed for 50 years." }
  ],
